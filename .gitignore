# OS generated files
*.DS_Store
.AppleDouble
.LSOverride
ehthumbs.db
Thumbs.db

# Icon must end with two \r
Icon

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# ignore app settings
library

### https://raw.github.com/github/gitignore/8767bd67830c90e45336e3244af3cf9d90a65c01/Global/Vim.gitignore

# swap
[._]*.s[a-w][a-z]
[._]s[a-w][a-z]
# session
Session.vim
# temporary
.netrwhist
*~
# auto-generated tag files
tags

# Ignore credentials
credentials

# vim plugin
.vim/dein
.vim/bookmark

.profile

# Ignore configs
.config/*
!.config/cmux/
!.config/ghostty/
!.config/yazi/
.vscode
.aws
# Ignore local config
.gitconfig.local

# === Nix / nix-darwin ===
# Build output symlinks (point into /nix/store, must never be committed).
# flake.nix / flake.lock / darwin/*.nix are intentionally tracked.
result
result-*
# nix develop + direnv cache (.envrc is ignored in .gitignore_global)
.direnv/

# The agents' runtime state (settings.json, sessions, plugins, logs) lives under
# $HOME, not here: darwin/home.nix links .claude / .codex / .gemini entry by
# entry instead of linking the directories (#143), so no allow-list is needed.

# local-only agent (project-specific content, not for the public repo)
.claude/agents/github-issue-manager.md

# Codex desktop's external-agent import mirrors .claude/ into .agents/. It no
# longer lands here (~/.claude is a real directory since #143), but keep the
# rule: it is generated output, not source — skills live in the plugin
# marketplaces.
.agents/
